{
  "expo": {
    "name": "GoodDay",
    "slug": "gd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/favicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14c871"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.siqueira2009.gd"
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "backgroundColor": "#00000000",
          "style": "auto",
          "enforceContrast": false
        }
      ]
    ],
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "auto"
      },
      "eas": {
        "projectId": "aff77864-b144-4c59-af29-726cffe61fb5"
      }
    }
  }
}
