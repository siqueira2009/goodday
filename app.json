{
  "expo": {
    "name": "GoodDay",
    "slug": "gd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/favicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14c871"
      },
      "edgeToEdgeEnabled": false
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "backgroundColor": "#00000000",
          "style": "auto",
          "enforceContrast": false
        }
      ]
    ],
    "web": {
      "favicon": "./src/assets/favicon.png"
    }
  }
}
